# Build output. NOT "/build" — that only anchors the root, which let app/build/
# be tracked for 25 commits. The generated BuildConfig.java carries the
# RevenueCat key, so this must stay ignored in a public repo.
build/
/captures
.externalNativeBuild
.cxx
local.properties
*.apk
*.aab
*.keystore
!debug.keystore

# Never commit these
/app/google-services.json
/revenuecat.properties
secrets.properties

# Local SDK path
local.properties
